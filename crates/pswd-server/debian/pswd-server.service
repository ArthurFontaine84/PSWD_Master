[Unit]
Description=Serveur de synchronisation des coffres pswd
After=network-online.target
Wants=network-online.target

[Service]
User=pswd-server
Group=pswd-server
ExecStart=/usr/bin/pswd-server serve
Restart=on-failure
# Le serveur laisse 10 s aux requêtes en cours.
TimeoutStopSec=20
UMask=0077

# Le service ne lit et n'écrit que son dossier de données.
ReadWritePaths=/var/lib/pswd-server
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
