{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ce que l'interface peut appeler : les commandes de PSWD Master et l'écoute de leurs événements ; ni fichiers, ni shell, ni réseau.",
  "windows": ["main"],
  "permissions": [
    "allow-list-vaults",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-current-vault",
    "allow-list-entries",
    "allow-entry-detail",
    "allow-list-tags",
    "allow-reveal-password",
    "allow-copy-password",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
