{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ce que l'interface peut appeler : les commandes de PSWD Master, l'écoute de leurs événements et les fenêtres système d'ouverture et d'enregistrement d'un fichier (seul le chemin choisi est transmis) ; ni lecture de fichiers, ni shell, ni réseau.",
  "windows": ["main"],
  "permissions": [
    "allow-device-kind",
    "allow-list-vaults",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-current-vault",
    "allow-app-hidden",
    "allow-app-shown",
    "allow-list-entries",
    "allow-entry-detail",
    "allow-list-tags",
    "allow-reveal-password",
    "allow-copy-password",
    "allow-add-entry",
    "allow-update-entry",
    "allow-delete-entry",
    "allow-entry-history",
    "allow-change-password",
    "allow-recover-vault",
    "allow-delete-vault",
    "allow-import-entries",
    "allow-backup-file-name",
    "allow-backup-to-file",
    "allow-backup-file-contents",
    "allow-restore-from-file",
    "allow-get-settings",
    "allow-save-settings",
    "allow-server-status",
    "allow-connect-server",
    "allow-sync-server",
    "allow-add-device-key",
    "allow-disconnect-server",
    "allow-sync-vault",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
