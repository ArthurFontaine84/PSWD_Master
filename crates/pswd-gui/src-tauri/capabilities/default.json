    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-current-vault",
    "allow-app-hidden",
    "allow-app-shown",
    "allow-list-entries",
    "allow-entry-detail",
    "allow-list-tags",
    "allow-reveal-password",
    "allow-copy-password",
    "allow-add-entry",
    "allow-update-entry",
    "allow-delete-entry",
    "allow-entry-history",
    "allow-change-password",
    "allow-recover-vault",
    "allow-delete-vault",
    "allow-import-entries",
    "allow-backup-file-name",
    "allow-backup-to-file",
    "allow-backup-file-contents",
    "allow-restore-from-file",
    "allow-get-settings",
    "allow-save-settings",
    "allow-server-status",
    "allow-connect-server",
    "allow-sync-server",
    "allow-refresh-server",
    "allow-add-device-key",
    "allow-disconnect-server",
    "allow-list-accounts",
    "allow-vault-members",
    "allow-invite-member",
    "allow-list-invitations",
    "allow-accept-invitation",
    "allow-delete-invitation",
    "allow-leave-vault",
    "allow-sync-vault",
    "allow-check-vault",
