    "allow-delete-vault-everywhere",
    "allow-admin-accounts",
    "allow-add-member",
    "allow-delete-account",
    "allow-set-admin",
    "allow-revoke-device",
    "allow-pending-keys",
    "allow-cancel-key",
    "allow-server-vaults",
    "allow-delete-server-vault",
    "allow-attach-account",
    "allow-remove-member",
    "allow-vault-versions",
    "allow-restore-version",
    "allow-set-public-address",
    "allow-server-backup-file-name",
    "allow-backup-server-to-file",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
